# Bu dosyayı .env olarak kopyalayıp doldurun, sonra: set -a; source .env; set +a
# Hiçbir değişken tanımlı değilse proje SQLite + bellek cache + konsol e-postası ile çalışır.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (POSTGRES_DB boşsa SQLite kullanılır)
POSTGRES_DB=waffle
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis cache (boşsa süreç içi bellek cache'i)
REDIS_URL=redis://localhost:6379/1

# SMTP e-posta (EMAIL_HOST boşsa e-postalar konsola yazılır)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=waffle@localhost

# Yüklenen dosyalar (Excel/CSV, syllabus PDF); boşsa ./media
MEDIA_ROOT=
